<?xml version="1.0" encoding="utf-8"?>
<!--
  Item 54 — what may leave the phone, and what may not.

  Vyana says "on this phone only". Android's default is the opposite: with
  no rules and no android:allowBackup, the system may copy the database
  (ring history, journal, cycle days) and the settings to the user's Google
  Drive. Nobody chose that, and on the 14 Nov reinstall nothing came back
  from it anyway — so it was all cost and no benefit.

  cloud-backup is empty of includes and excludes everything: nothing goes to
  Google. device-transfer is left permitted, because a phone-to-phone move
  never leaves the user's own hands, and losing years of history when
  someone changes handset would be its own kind of data loss. Vyana's own
  backup (item 53) is how history is meant to travel.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
